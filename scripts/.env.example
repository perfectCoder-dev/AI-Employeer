# Environment variables for AI Employee Scripts

# Vault path
VAULT_DIR=/absolute/path/to/AI_Employee_Vault
SCRIPTS_DIR=/absolute/path/to/AI_Employee_Vault/scripts

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Watcher configuration
WATCH_INTERVAL=1  # seconds between checks

# Optional: Groq key for higher-quality draft generation.
# If omitted, the agent uses deterministic handbook-based templates.
GROQ_API_KEY=

# Gmail API credentials and token paths
CREDENTIALS_PATH=/absolute/path/to/AI_Employee_Vault/credentials/credentials.json
TOKEN_PATH=/absolute/path/to/AI_Employee_Vault/credentials/token.json

# University handbook knowledge base
UNIVERSITY_HANDBOOK_PATH=/absolute/path/to/AI_Employee_Vault/docs/University_Handbook.md

# Dashboard approve/reject protection. Set this in production and send it as X-Approval-Token.
DASHBOARD_APPROVAL_TOKEN=

# University deployments should keep this false unless explicitly needed.
AUTO_LINKEDIN_POSTS=false

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
