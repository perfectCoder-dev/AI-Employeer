# Environment variables for AI Employee Scripts

# Obsidian vault path (if needed)
VAULT_PATH=../

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Watcher configuration
WATCH_INTERVAL=1  # seconds between checks

# Optional: API keys for extended functionality
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gmail API credentials and token paths
CREDENTIALS_PATH=./credentials/credentials.json
TOKEN_PATH=./credentials/token.json

LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=GROQ_API_KEY=your_groq_api_key_here
